{
  "name": "dsh-univer-office-oss",
  "version": "0.1.0",
  "description": "Fully local DSH office editing with OSS Univer and SuperDoc's engine-agnostic Document API.",
  "type": "module",
  "main": "./lib/index.js",
  "files": ["lib", "artifacts", "docs", "skills", "vendor/superdoc-document-api", "README.md", "README.zh-CN.md", "LICENSE", "THIRD_PARTY_LICENSES.md", "cordis.patch.yml"],
  "exports": {".": "./lib/index.js", "./client": {"default": "./lib/client.js"}, "./package.json": "./package.json"},
  "keywords": ["dsh", "univer", "superdoc", "spreadsheet", "docx", "offline", "open-source"],
  "license": "AGPL-3.0-only",
  "repository": {"type": "git", "url": "git+https://github.com/stonelinlin/dsh-univer-office-oss.git"},
  "engines": {"node": ">=22.19.0"},
  "packageManager": "pnpm@11.20.0",
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:lib": "node scripts/build.mjs lib",
    "build:viewer": "node scripts/build.mjs viewer",
    "build:superdoc-contract": "tsc --build vendor/superdoc-document-api/tsconfig.json --force",
    "typecheck": "pnpm run build:superdoc-contract && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.client.json --noEmit",
    "test:local": "node --experimental-strip-types --test test/local-store.test.ts",
    "test:host": "node test/host-smoke.mjs",
    "test:client": "node test/client-smoke.mjs",
    "test:skills": "node test/skills-smoke.mjs",
    "test": "pnpm run build && pnpm run test:local && pnpm run test:host && pnpm run test:client && pnpm run test:skills",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "@superdoc/document-api": "workspace:*",
    "@univerjs/core": "workspace:*",
    "@univerjs/data-validation": "workspace:*",
    "@univerjs/docs": "workspace:*",
    "@univerjs/docs-drawing": "workspace:*",
    "@univerjs/drawing": "workspace:*",
    "@univerjs/engine-formula": "workspace:*",
    "@univerjs/preset-docs-core": "workspace:*",
    "@univerjs/preset-sheets-core": "workspace:*",
    "@univerjs/presets": "workspace:*",
    "@univerjs/sheets": "workspace:*",
    "@univerjs/sheets-conditional-formatting": "workspace:*",
    "@univerjs/sheets-data-validation": "workspace:*",
    "@univerjs/sheets-drawing": "workspace:*",
    "@univerjs/sheets-filter": "workspace:*",
    "@univerjs/sheets-formula": "workspace:*",
    "@univerjs/sheets-hyper-link": "workspace:*",
    "@univerjs/sheets-numfmt": "workspace:*",
    "@univerjs/sheets-sort": "workspace:*",
    "@univerjs/thread-comment": "workspace:*",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "mammoth": "1.12.1",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "18.3.7",
    "@tailwindcss/vite": "4.3.3",
    "esbuild": "^0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.2"
  }
}
